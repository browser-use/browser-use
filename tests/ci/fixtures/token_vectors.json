{
	"about": "Shared test vectors for browser tokens: a body with the dummy, the same body after the swap. Each token's dummy is fixed here (generation is random); the library (tests/ci/test_tokens.py) and proxy-use run the same file.",
	"vectors": [
		{"name": "form card with spaces as +", "kind": "card", "real": "4242424242424242", "dummy": "4242 4291 7731 7391", "content_type": "application/x-www-form-urlencoded", "body": "card%5Bnumber%5D=4242+4291+7731+7391&x=1", "expected": "card%5Bnumber%5D=4242+4242+4242+4242&x=1"},
		{"name": "form card with spaces as %20", "kind": "card", "real": "4242424242424242", "dummy": "4242 4291 7731 7391", "content_type": "application/x-www-form-urlencoded", "body": "card=4242%204291%207731%207391", "expected": "card=4242%204242%204242%204242"},
		{"name": "json card as a number", "kind": "card", "real": "4242424242424242", "dummy": "4242 4291 7731 7391", "content_type": "application/json", "body": "{\"pan\":4242429177317391}", "expected": "{\"pan\":4242424242424242}"},
		{"name": "json card with dashes", "kind": "card", "real": "4242424242424242", "dummy": "4242 4291 7731 7391", "content_type": "application/json", "body": "{\"pan\":\"4242-4291-7731-7391\"}", "expected": "{\"pan\":\"4242-4242-4242-4242\"}"},
		{"name": "longer digit run is not the card", "kind": "card", "real": "4242424242424242", "dummy": "4242 4291 7731 7391", "content_type": "application/json", "body": "{\"id\":\"142424291773173910\"}", "expected": "{\"id\":\"142424291773173910\"}"},
		{"name": "ssn with dashes in text/plain", "kind": "ssn", "real": "123456789", "dummy": "301-52-7788", "content_type": "text/plain", "body": "ssn 301-52-7788.", "expected": "ssn 123-45-6789."},
		{"name": "ssn with %2D in a form", "kind": "ssn", "real": "123456789", "dummy": "301-52-7788", "content_type": "application/x-www-form-urlencoded", "body": "ssn=301%2D52%2D7788", "expected": "ssn=123%2D45%2D6789"},
		{"name": "iban lower case with spaces", "kind": "iban", "real": "DE89370400440532013000", "dummy": "DE42 7783 5337 4068 1241 58", "content_type": "application/json", "body": "{\"iban\":\"de42 7783 5337 4068 1241 58\"}", "expected": "{\"iban\":\"de89 3704 0044 0532 0130 00\"}"},
		{"name": "text in json is JSON-escaped", "kind": "text", "real": "742 Evergreen \"Terrace\" #5 Ü", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "application/json", "body": "{\"street\":\"318 Qmwpxzkrb Hvtdsqjel a8 K\"}", "expected": "{\"street\":\"742 Evergreen \\\"Terrace\\\" #5 Ü\"}"},
		{"name": "text in a form is percent-encoded with + spaces", "kind": "text", "real": "742 Evergreen \"Terrace\" #5 Ü", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "application/x-www-form-urlencoded", "body": "street=318+Qmwpxzkrb+Hvtdsqjel+a8+K", "expected": "street=742+Evergreen+%22Terrace%22+%235+%C3%9C"},
		{"name": "text in a form with %20 spaces", "kind": "text", "real": "742 Evergreen \"Terrace\" #5 Ü", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "application/x-www-form-urlencoded", "body": "street=318%20Qmwpxzkrb%20Hvtdsqjel%20a8%20K", "expected": "street=742%20Evergreen%20%22Terrace%22%20%235%20%C3%9C"},
		{"name": "text upper-cased by the page", "kind": "text", "real": "742 Evergreen Terrace", "dummy": "318 Qmwpxzkrb Hvtdsqj", "content_type": "text/plain", "body": "318 QMWPXZKRB HVTDSQJ", "expected": "742 EVERGREEN TERRACE"},
		{"name": "text inside a longer word is not swapped", "kind": "text", "real": "742 Evergreen Terrace", "dummy": "318 Qmwpxzkrb Hvtdsqj", "content_type": "text/plain", "body": "x318 Qmwpxzkrb Hvtdsqjy", "expected": "x318 Qmwpxzkrb Hvtdsqjy"},
		{"name": "unknown type: a real value that needs escaping is not written", "kind": "text", "real": "742 Evergreen \"Terrace\"", "dummy": "318 Qmwpxzkrb Hvtdsqjel", "content_type": "application/octet-stream", "body": "318 Qmwpxzkrb Hvtdsqjel", "expected": "318 Qmwpxzkrb Hvtdsqjel"},
		{"name": "unknown type: a plain value is written", "kind": "ssn", "real": "123456789", "dummy": "301-52-7788", "content_type": "", "body": "s=301-52-7788", "expected": "s=123-45-6789"},
		{"name": "text in JSON sent as text/plain is JSON-escaped", "kind": "text", "real": "742 Evergreen \"Terrace\" #5 Ü", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "text/plain;charset=UTF-8", "body": "{\"street\":\"318 Qmwpxzkrb Hvtdsqjel a8 K\"}", "expected": "{\"street\":\"742 Evergreen \\\"Terrace\\\" #5 Ü\"}"},
		{"name": "text in XML is entity-escaped", "kind": "text", "real": "742 Evergreen \"Terrace\" & <5>", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "text/xml", "body": "<s>318 Qmwpxzkrb Hvtdsqjel a8 K</s>", "expected": "<s>742 Evergreen &quot;Terrace&quot; &amp; &lt;5&gt;</s>"},
		{"name": "plain text: a value that needs escaping is not written", "kind": "text", "real": "742 Evergreen \"Terrace\" #5 Ü", "dummy": "318 Qmwpxzkrb Hvtdsqjel a8 K", "content_type": "text/plain", "body": "street 318 Qmwpxzkrb Hvtdsqjel a8 K", "expected": "street 318 Qmwpxzkrb Hvtdsqjel a8 K"},
		{"name": "base64 body is not decoded", "kind": "ssn", "real": "123456789", "dummy": "301-52-7788", "content_type": "text/plain", "body": "MzAxLTUyLTc3ODg=", "expected": "MzAxLTUyLTc3ODg="}
	]
}
