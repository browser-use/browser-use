# browser-use 1.0 reads a .env file in the working directory on import. Copy this file to .env and fill in what you use.

# One Browser Use key runs the default model (bu-fast), cloud browsers and web search.
# Get one at https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=

# Your own model: llm=ChatOpenAI(...), ChatAnthropic(...) or ChatGoogle(...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=          # an OpenAI-compatible server
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_ENDPOINT=    # llm='azure:<deployment>' needs these three
# AZURE_OPENAI_API_KEY=
# OPENAI_API_VERSION=
# GOOGLE_API_KEY=

# Log level: debug, info (default), warning, error
# BROWSER_USE_LOGGING_LEVEL=info

# Anonymized usage telemetry; false turns it off
# ANONYMIZED_TELEMETRY=false
